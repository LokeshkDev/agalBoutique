PORT=5000
NODE_ENV=development

# MySQL AWS Lightsail Connection Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=agal_boutique

# Frontend Origin for CORS
WEB_URL=http://localhost:3000

# Admin Auth Security
JWT_SECRET=super_secret_jwt_key_agal_boutique_2026
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_secure_password_123

# Razorpay Integration (Optional in DEV mode, required in Production)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Cloudflare R2 Storage & Optimization Configuration
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=agal-boutique-images
R2_PUBLIC_DOMAIN=https://pub-xxxxxx.r2.dev

